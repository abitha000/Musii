API_ID=
API_HASH=
BOT_TOKEN=
MONGO_DB_URI=
LOGGER_ID=
OWNER_ID=
STRING_SESSIONS=
PROXY_URL=

# Recommended for YouTube account/age verification.
# Store only as a Northflank secret; never commit cookies.txt.
YOUTUBE_COOKIES_B64=

# Optional: path to a mounted Netscape-format cookie file.
YOUTUBE_COOKIES_FILE=

# Local bgutil provider is enabled by default inside the Docker image.
YOUTUBE_POT_PROVIDER_URL=http://127.0.0.1:4416
YOUTUBE_POT_PROVIDER_ENABLED=1
